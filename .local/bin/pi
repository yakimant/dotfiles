#!/usr/bin/env bash
set -euo pipefail

export PI_SKIP_VERSION_CHECK=1

TRUST_FILE="$HOME/.config/pi/trust.json"
REAL_PI="/run/current-system/sw/bin/pi"
cwd="$(pwd -P)"

# provider: explicit arg > env > default
PROVIDERS=(codex synthetic openai)
provider="${PI_PROVIDER:-codex}"

declare -A DEFAULT_MODEL=(
  [codex]="openai-codex/gpt-6.1-sol"
  [synthetic]="synthetic/hf:deepseek-ai/DeepSeek-V4.1-Flash"
  [openai]="openai/gpt-6-luna"
)


trusted="$(
  jq -r --arg cwd "$cwd" '.[$cwd] // false' "$TRUST_FILE" 2>/dev/null \
    || printf 'false'
)"

nono_args=()
pi_args=()

if [[ -d "$cwd/.git" ]]; then
  nono_args+=(--silent --allow-cwd --allow "$cwd")
fi

profile="pi-${provider}"
pi_args+=(--model "${DEFAULT_MODEL[$provider]}")
if [[ "$trusted" != "true" ]]; then
  pi_args+=(--no-context-files --no-session)
fi

printf 'nono: %s\n' "$profile" >&2

exec nono run \
  --profile "$profile" \
  "${nono_args[@]}" \
  -- ${REAL_PI} \
  "${pi_args[@]}" \
  "$@"
