{
  "collapseChangelog": true,
  "theme": "light",
  "defaultProjectTrust": "never",
  "quietStartup": true,
  "packages": [
    "npm:pi-web-search@1.5.0"
  ],
  "extensions": [],
  "skills": [],
  "prompts": [],
  "themes": [],
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "httpIdleTimeoutMs": 300000,
  "transport": "auto",
  "compaction": {
    "enabled": true
  }
}
