{
  // nono profile schema --output nono-profile.schema.json
  "$schema": "../nono-profile.schema.json",
  "extends": ["default"],
  "meta": {
    "name": "strict",
    "version": "",
    "description": "Strict default skeleton",
    "author": null,
  },
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": "isolated",
    "ipc_mode": "shared_memory_only",
    "capability_elevation": false,
    "wsl2_proxy_policy": "error",
  },
  "groups": {
    "include": [],
    "exclude": ["user_tools"],
  },
  "commands": {
    "allow": [],
    "deny": [],
  },
  "filesystem": {
    "allow": [],
    "read": [],
    "write": [],
    "allow_file": [],
    "read_file": ["$HOME/.local/bin/pi"],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [
      // SSH / crypto / password stores
      "$HOME/.ssh",
      "$HOME/.gnupg",
      "$HOME/.password-store",
      "$HOME/.passage",
      "$HOME/.local/share/gopass/stores",

      "$HOME/.zsh_history",

      // Cloud / infrastructure credentials
      "$HOME/.aws",
      "$HOME/.azure",
      "$HOME/.docker",
      "$HOME/.terraform.d",
      "$HOME/.boto",
      "$HOME/.s3cfg",
      "$HOME/.kube",
      "$HOME/.config/yandex-cloud",
      "$HOME/.config/hcloud/cli.toml",
      "$HOME/.config/gcloud",
      "$HOME/.config/nix/netrc",
      "$HOME/.config/cachix",

      // Sensitive
      "$HOME/.local/share/signal-cli",
      "$HOME/.local/share/weechat",
      "$HOME/.local/state/.copilot",
      "$HOME/.local/state/nono",

      // Credential/session tokens
      "$HOME/.bwsession",

      // Protect the sandbox configuration itself
      "$HOME/.config/nono",

      // macOS credentials
      "$HOME/Library/Keychains",

      // Personal / synced data where writes can have large blast radius
      "$HOME/Documents",
      "$HOME/Downloads",
      "$HOME/Desktop",
      "$HOME/Library/CloudStorage",
      "$HOME/My Drive",
      "$HOME/Google Drive",

      // Workdir secrets
      "$WORKDIR/.env",
      "$WORKDIR/.env.local",
      "$WORKDIR/.env.production",
      "$WORKDIR/.env.development",
      "$WORKDIR/.env.test",
      "$WORKDIR/.envrc",

      "$WORKDIR/.npmrc",
      "$WORKDIR/.pypirc",
      "$WORKDIR/.netrc",
    ],
    "bypass_protection": [],
    "suppress_save_prompt": [],
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "network_profile": null,
    "allow_domain": ["nono-baseline.invalid"],
    "deny_domain": [],
    "credentials": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": "127.0.0.1:8080",
    "upstream_bypass": [],
  },
  "diagnostics": {
    "suppress_system_services": [],
  },
  "linux": {
    "af_unix_mediation": "pathname",
    "sandbox_policy": null,
  },
  "env_credentials": {},
  "environment": {
    "deny_vars": ["*"],
    "set_vars": {},
  },
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none",
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": [],
  },
  "open_urls": {
    "allow_origins": [],
    "allow_localhost": false,
  },
  "allow_launch_services": false,
  "allow_gpu": false,
  "interactive": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": [],
}
