{
  "extends": ["pi"],
  "meta": {
    "name": "pi-synthetic",
    "description": "PI Synthetic",
  },
  "network": {
    "credentials": ["synthetic"],
    "custom_credentials": {
      "synthetic": {
        "upstream": "https://api.synthetic.new/openai/v1",
        "credential_key": "synthetic",
        "env_var": "SYNTHETIC_API_KEY",
      },
    },
  },
}
