# Hard overrides and host sections
Include ~/.ssh/config.local.override

Host github.com
  User git

  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h:%p
  ControlPersist 10m

  # SK / Yubikey FIDO
  IdentityFile ~/.ssh/id_ed25519_sk_touch_24553389
  IdentityFile ~/.ssh/id_ed25519_sk_touch_24553378

  CanonicalizeHostname no
  ForwardAgent no

Host *
  # Soft overrides
  Include ~/.ssh/config.local.defaults

  # SK / Yubikey FIDO
  IdentityFile ~/.ssh/id_ed25519_sk_no_touch_24553389
  IdentityFile ~/.ssh/id_ed25519_sk_no_touch_24553378
  # Yubikey GPG
  IdentityFile ~/.ssh/id_ed25519_gpg.pub

  ForwardAgent no
  SendEnv -LC_* -LANG
  # SetEnv TERM=xterm

  CanonicalizeHostname yes
  CanonicalizeMaxDots 3
  CanonicalizeFallbackLocal yes

  AddKeysToAgent yes

  ServerAliveInterval 5
  ServerAliveCountMax 60
  ConnectTimeout 10

  CheckHostIP yes
  IdentitiesOnly yes
  PasswordAuthentication no
  UpdateHostKeys ask
